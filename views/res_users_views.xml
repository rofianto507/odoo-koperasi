<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_users_form_koperasi" model="ir.ui.view">
            <field name="name">res.users.form.koperasi</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Koperasi" name="koperasi"
                          groups="koperasi.group_koperasi_operator">
                        <group>
                            <field name="koperasi_mitra_id"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
