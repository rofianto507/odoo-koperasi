<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_koperasi_shu_list" model="ir.ui.view">
            <field name="name">koperasi.shu.list</field>
            <field name="model">koperasi.shu</field>
            <field name="arch" type="xml">
                <list string="Tutup Buku &amp; Laba">
                    <field name="currency_id" column_invisible="1"/>
                    <field name="name"/>
                    <field name="tahun" options="{'enable_formatting': false}"/>
                    <field name="total_pendapatan"/>
                    <field name="total_beban"/>
                    <field name="shu"/>
                    <field name="nominal_pemodal"/>
                    <field name="laba_atas_modal" optional="show"/>
                    <field name="state" widget="badge"
                           decoration-muted="state == 'draft'"
                           decoration-warning="state == 'ditetapkan'"
                           decoration-success="state == 'dibayar'"/>
                </list>
            </field>
        </record>

        <record id="view_koperasi_shu_form" model="ir.ui.view">
            <field name="name">koperasi.shu.form</field>
            <field name="model">koperasi.shu</field>
            <field name="arch" type="xml">
                <form string="Tutup Buku &amp; Laba">
                    <header>
                        <button name="action_hitung" type="object" string="Hitung Laba"
                                class="btn-primary" invisible="state != 'draft'"/>
                        <button name="action_tetapkan" type="object" string="Tetapkan &amp; Tutup Buku"
                                invisible="state != 'draft'"
                                confirm="Laba dihitung ulang, pembagiannya ditetapkan, dan jurnal penutup per 31 Desember dibuat. Semua periode tahun ini harus sudah ditutup. Lanjutkan?"/>
                        <button name="action_bayar" type="object" string="Catat Pembayaran"
                                class="btn-primary" invisible="state != 'ditetapkan'"
                                confirm="Imbal hasil pemodal, imbalan anggota, dan komisi mitra dicatat dibayar hari ini dari Bank. Setelah ini penetapan tidak dapat dibatalkan. Lanjutkan?"/>
                        <button name="action_draft" type="object" string="Batalkan Penetapan"
                                invisible="state != 'ditetapkan'"
                                confirm="Jurnal penutup akan dihapus dan tutup buku kembali ke Draft. Lanjutkan?"/>
                        <button name="action_cetak" type="object" string="Cetak PDF"
                                icon="fa-file-pdf-o" invisible="not tanggal_hitung"/>
                        <button name="action_excel" type="object" string="Unduh Excel"
                                class="btn-success" icon="fa-file-excel-o" invisible="not tanggal_hitung"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="alert alert-info" role="alert" invisible="state != 'draft'">
                            Selama Draft ini adalah simulasi: klik <b>Hitung Laba</b> kapan saja untuk melihat
                            perkiraan dari jurnal yang sudah diposting, dan ubah persentasenya untuk membandingkan.
                            Laba baru dapat ditetapkan setelah semua periode tahun buku ini ditutup.
                        </div>
                        <div class="oe_title">
                            <h1><field name="name"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="currency_id" invisible="1"/>
                                <field name="tahun" options="{'enable_formatting': false}" readonly="state != 'draft'"/>
                                <field name="tanggal_hitung"/>
                            </group>
                            <group>
                                <field name="tanggal_tetap" invisible="not tanggal_tetap"/>
                                <field name="jurnal_id" invisible="not jurnal_id"/>
                                <field name="tanggal_bayar" invisible="not tanggal_bayar"/>
                                <field name="jurnal_bayar_id" invisible="not jurnal_bayar_id"/>
                            </group>
                        </group>
                        <group>
                            <group string="Hasil Usaha">
                                <field name="total_pendapatan"/>
                                <field name="total_beban"/>
                                <field name="shu" class="fw-bold"/>
                            </group>
                            <group string="Dibanding Modal">
                                <field name="modal_penyertaan"/>
                                <field name="laba_atas_modal"/>
                                <field name="imbal_atas_modal"/>
                            </group>
                        </group>
                        <group>
                            <group string="Persentase Pembagian">
                                <field name="persen_pemodal" readonly="state != 'draft'"/>
                                <field name="persen_ditahan" readonly="state != 'draft'"/>
                                <field name="persen_anggota" readonly="state != 'draft'"/>
                                <field name="persen_mitra" readonly="state != 'draft'"/>
                            </group>
                            <group string="Hasil Pembagian" invisible="not tanggal_hitung">
                                <field name="nominal_pemodal" class="fw-bold"/>
                                <field name="nominal_ditahan"/>
                                <field name="nominal_anggota"/>
                                <field name="nominal_mitra"/>
                                <field name="nominal_dibayar"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Komisi per Mitra" name="mitra">
                                <field name="mitra_ids">
                                    <list>
                                        <field name="currency_id" column_invisible="1"/>
                                        <field name="mitra_id"/>
                                        <field name="dasar_pendapatan" sum="Total"/>
                                        <field name="komisi" sum="Total"/>
                                    </list>
                                </field>
                                <p class="text-muted">
                                    Komisi dibagi sebanding pendapatan (jasa pinjaman dan biaya administrasi)
                                    yang dihasilkan anggota tiap mitra selama tahun buku.
                                </p>
                            </page>
                            <page string="Imbalan per Anggota" name="anggota">
                                <field name="line_ids">
                                    <list>
                                        <field name="currency_id" column_invisible="1"/>
                                        <field name="anggota_id"/>
                                        <field name="mitra_id"/>
                                        <field name="dasar_simpanan" sum="Total"/>
                                        <field name="total" sum="Total"/>
                                    </list>
                                </field>
                                <p class="text-muted">
                                    Imbalan dibagi sebanding saldo simpanan (pokok, wajib, sukarela) tiap anggota
                                    pada akhir tahun buku. Sisa pembulatan masuk Laba Ditahan.
                                </p>
                            </page>
                            <page string="Catatan" name="catatan">
                                <field name="catatan" placeholder="Dasar keputusan pembagian, catatan rapat, dst."/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_koperasi_shu" model="ir.actions.act_window">
            <field name="name">Tutup Buku &amp; Laba</field>
            <field name="res_model">koperasi.shu</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Belum ada tutup buku</p>
                <p>Buat satu untuk tiap tahun buku. Selama Draft, laba dan pembagiannya bisa dihitung
                   kapan saja sebagai simulasi.</p>
            </field>
        </record>

        <menuitem id="menu_koperasi_shu" name="Tutup Buku &amp; Laba" parent="menu_koperasi_pembukuan"
                  action="action_koperasi_shu" sequence="25"/>

    </data>
</odoo>
