<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_koperasi_buat_tagihan_wizard_form" model="ir.ui.view">
            <field name="name">koperasi.buat.tagihan.wizard.form</field>
            <field name="model">koperasi.buat.tagihan.wizard</field>
            <field name="arch" type="xml">
                <form string="Buat Tagihan">
                    <group>
                        <group>
                            <field name="periode_id" options="{'no_create': True, 'no_open': True}"/>
                        </group>
                        <group>
                            <field name="mitra_ids" widget="many2many_tags"
                                   options="{'no_create': True}" placeholder="Semua mitra"/>
                        </group>
                    </group>
                    <p class="text-muted">
                        Tagihan dibuat berstatus Draft, satu per mitra, berisi semua anggota aktif.
                        Mitra yang sudah punya tagihan pada periode ini dilewati.
                    </p>
                    <footer>
                        <button name="action_buat" type="object" string="Buat Tagihan" class="btn-primary"/>
                        <button special="cancel" string="Batal" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_koperasi_buat_tagihan_wizard" model="ir.actions.act_window">
            <field name="name">Buat Tagihan</field>
            <field name="res_model">koperasi.buat.tagihan.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
