<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

    <record id="module_category_koperasi" model="ir.module.category">
        <field name="name">Koperasi</field>
        <field name="sequence">56</field>
    </record>

    <record id="privilege_koperasi_access" model="res.groups.privilege">
        <field name="name">Koperasi</field>
        <field name="category_id" ref="module_category_koperasi"/>
    </record>

    <!-- Admin mitra: internal user yang hanya melihat data mitranya sendiri -->
    <record id="group_koperasi_mitra" model="res.groups">
        <field name="name">Admin Mitra</field>
        <field name="privilege_id" ref="privilege_koperasi_access"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Operator pusat: admin platform simpan pinjam, melihat semua mitra -->
    <record id="group_koperasi_operator" model="res.groups">
        <field name="name">Operator Pusat</field>
        <field name="privilege_id" ref="privilege_koperasi_access"/>
        <field name="implied_ids" eval="[(4, ref('group_koperasi_mitra'))]"/>
    </record>

    <record id="base.user_admin" model="res.users">
        <field name="group_ids" eval="[(4, ref('group_koperasi_operator'))]"/>
    </record>

    </data>
</odoo>
